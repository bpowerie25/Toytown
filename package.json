{
  "name": "toytown-gl-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./examples/**\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "models:generate": "python3 assets/generator/generate_models.py",
    "models:check": "python3 assets/generator/check_reproducible.py",
    "test:e2e": "docker run --rm --ipc=host -e CI -e DOCS_SCREENSHOTS -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test",
    "test:e2e:update": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npx playwright test --update-snapshots",
    "data:waterford": "node packages/cli/dist/index.js build-data --bbox=-7.17,52.22,-7.05,52.28 --out examples/waterford/public/data/waterford.geojson --stats .cache/stats/waterford.json",
    "data:tramore": "node packages/cli/dist/index.js build-data --bbox=-7.18,52.135,-7.12,52.18 --out examples/tramore/public/data/tramore.geojson --stats .cache/stats/tramore.json",
    "data:report": "node packages/cli/dist/index.js report Waterford=.cache/stats/waterford.json Tramore=.cache/stats/tramore.json --out docs/classification-report.md",
    "data:build": "pnpm --filter toytown-gl --filter @toytown/cli build && pnpm data:waterford && pnpm data:tramore && pnpm data:report",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && prettier --write \"**/CHANGELOG.md\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
