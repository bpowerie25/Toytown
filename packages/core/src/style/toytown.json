{
  "version": 8,
  "name": "toytown",
  "metadata": {
    "toytown:palette": {
      "land": "#F4EBD0",
      "water": "#7EC8E3",
      "grass": "#A8D5A2",
      "wood": "#6BAA5E",
      "sand": "#F6E3B4",
      "road": "#FFFFFF",
      "road_casing": "#D9C9A3",
      "major_road": "#FFE8A3",
      "major_road_casing": "#E0B85C",
      "rail": "#B8B2A7",
      "label": "#2B2D42",
      "label_halo": "#FFFFFF",
      "building": "#E8DCBE",
      "building_outline": "#D9C9A3"
    },
    "toytown:baseBuildingLayer": "toytown-base-buildings",
    "toytown:colors": {
      "background/background-color": "land",
      "landcover-wood/fill-color": "wood",
      "landcover-grass/fill-color": "grass",
      "landuse-grass/fill-color": "grass",
      "park/fill-color": "grass",
      "landcover-sand/fill-color": "sand",
      "water/fill-color": "water",
      "waterway-river/line-color": "water",
      "waterway-stream/line-color": "water",
      "toytown-base-buildings/fill-color": "building",
      "toytown-base-buildings/fill-outline-color": "building_outline",
      "rail/line-color": "rail",
      "rail-sleepers/line-color": "road_casing",
      "path-casing/line-color": "road_casing",
      "path/line-color": "road_casing",
      "road-service-casing/line-color": "road_casing",
      "road-service/line-color": "road_casing",
      "road-minor-casing/line-color": "road_casing",
      "road-minor/line-color": "road_casing",
      "road-major-casing/line-color": "major_road_casing",
      "road-major/line-color": "major_road",
      "label-waterway/text-color": "label",
      "label-waterway/text-halo-color": "road_casing",
      "label-water-line/text-color": "label",
      "label-water-line/text-halo-color": "road_casing",
      "label-water-point/text-color": "label",
      "label-water-point/text-halo-color": "road_casing",
      "label-road-major/text-color": "label",
      "label-road-major/text-halo-color": "road_casing",
      "label-place/text-color": "label",
      "label-place/text-halo-color": "road_casing"
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "glyphs": "https://tiles.versatiles.org/assets/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F4EBD0"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#6BAA5E"
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": {
        "fill-color": "#A8D5A2"
      }
    },
    {
      "id": "landuse-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["cemetery", "pitch", "playground", "garden"]]
      ],
      "paint": {
        "fill-color": "#A8D5A2"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#A8D5A2",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"],
      "paint": {
        "fill-color": "#F6E3B4"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["Polygon", "MultiPolygon"]]],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "fill-color": "#7EC8E3"
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["==", ["get", "class"], "river"],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#7EC8E3",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, 1, 12, 2.5, 16, 10, 18, 24]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 13,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["!=", ["get", "class"], "river"],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#7EC8E3",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 1, 16, 3, 18, 7]
      }
    },
    {
      "id": "toytown-base-buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E8DCBE",
        "fill-outline-color": "#D9C9A3"
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["rail", "transit"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#B8B2A7",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 1.5, 16, 5, 18, 10],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "rail-sleepers",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["rail", "transit"]]],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 1, 16, 2, 18, 4],
        "line-dasharray": [1, 2]
      }
    },
    {
      "id": "path-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["==", ["get", "class"], "path"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9C9A3",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 15, 2.5, 18, 7],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["==", ["get", "class"], "path"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 15, 1.2, 18, 4.5],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-service-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["service", "track"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9C9A3",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 3.5, 16, 10, 18, 23],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-service",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["service", "track"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 1.5, 16, 6, 18, 16],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["tertiary", "minor", "busway"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D9C9A3",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          12,
          2.5,
          14,
          7,
          16,
          16,
          18,
          40
        ],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["tertiary", "minor", "busway"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          12,
          1,
          14,
          3.5,
          16,
          11,
          18,
          30
        ],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E0B85C",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          8,
          2.5,
          12,
          6,
          14,
          12.5,
          16,
          25,
          18,
          58
        ],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFE8A3",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          8,
          1,
          12,
          3,
          14,
          7,
          16,
          17,
          18,
          46
        ],
        "line-opacity": ["match", ["get", "brunnel"], "tunnel", 0.5, 1]
      }
    },
    {
      "id": "label-waterway",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 12,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["==", ["get", "class"], "river"],
        ["has", "name"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["nunito_bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 13, 17, 19],
        "text-letter-spacing": 0.1,
        "symbol-spacing": 600,
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#2B2D42",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-water-line",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["has", "name"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["nunito_bold"],
        "text-size": 14,
        "text-letter-spacing": 0.1,
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#2B2D42",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-water-point",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["Point", "MultiPoint"]]],
        ["has", "name"]
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["nunito_bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 12, 16, 16],
        "text-letter-spacing": 0.1,
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#2B2D42",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-road-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["LineString", "MultiLineString"]]],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
        ["has", "name"]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["nunito_bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 11, 17, 16],
        "symbol-spacing": 350,
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#2B2D42",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "label-place",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "all",
        ["in", ["geometry-type"], ["literal", ["Point", "MultiPoint"]]],
        ["in", ["get", "class"], ["literal", ["city", "town", "village"]]]
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["nunito_extrabold"],
        "text-max-width": 8,
        "symbol-sort-key": ["get", "rank"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          ["match", ["get", "class"], "city", 15, "town", 12, 10],
          15,
          ["match", ["get", "class"], "city", 28, "town", 24, 18]
        ]
      },
      "paint": {
        "text-color": "#2B2D42",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 2.5,
        "text-halo-blur": 0.5
      }
    }
  ]
}
