{
  "name": "toytown-gl",
  "version": "0.0.0",
  "description": "Drop-in MapLibre plugin that renders OpenStreetMap as a cartoony toy town.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "maplibre",
    "openstreetmap",
    "three",
    "3d",
    "toy",
    "low-poly"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "~0.186.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "maplibre-gl": "^5.24.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
