    "buildings",
    "cc0",
    "three",
    "babylonjs",
    "godot",
    "unity"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "author": "Brian Power",
  "homepage": "https://github.com/bpowerie25/Toytown/tree/main/packages/models#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpowerie25/Toytown.git",
    "directory": "packages/models"
  },
  "bugs": {
